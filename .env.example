# Copiez ce fichier vers .env puis adaptez les valeurs.

# Port d'écoute de l'API
PORT=3000

# Adresse de la base MongoDB (locale, Docker ou MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/my_social_networks

# Secret de signature des tokens JWT (32 caractères minimum).
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Durée de validité d'un token
JWT_EXPIRES_IN=2h

# Origine autorisée par CORS (* = toutes)
CORS_ORIGIN=*

# Adresse du site utilisée dans les liens de partage d'événements
PUBLIC_APP_URL=http://localhost:3000

# Adresse de la documentation Postman publiée (affichée par GET /api)
POSTMAN_DOC_URL=
